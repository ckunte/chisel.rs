# Site settings
# Imported by base.j2, home.j2, and feed.j2 -- edit these to fit your site.

# Site name (used in <title> and the header)
{%- set site_title = "My Site" -%}

# Author name
{%- set site_author = "Your Name" -%}

# Site url (no trailing slash)
{%- set site_url = "https://example.com" -%}

# Short description, used in <meta name="description"> and feed.json
{%- set site_desc = "a short description of this site" -%}
